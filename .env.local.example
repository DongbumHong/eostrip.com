# EmailJS 설정 (https://www.emailjs.com/ → Account → API Keys)
# .env.local 파일을 만들고 아래 값을 채워주세요.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# 비고:
# - 이 키들은 모두 NEXT_PUBLIC_* 으로 클라이언트에 노출됩니다 (EmailJS 설계상 안전).
# - 보안은 EmailJS 대시보드의 Allowed Origins 로 도메인 화이트리스트를 설정하세요.
#   예: https://eostrip.com, https://www.eostrip.com, https://*.vercel.app
# - 템플릿 변수: from_name, from_email, message, page_source
#   Reply-To: {{from_email}} / 수신: fukuoka@eostrip.com
